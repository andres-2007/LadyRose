# Copien este archivo como .env y cambien los valores

SECRET_KEY=cambiar-esta-clave
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos. Si dejan sqlite no hay que instalar nada más.
DB_ENGINE=sqlite
# Para PostgreSQL:
# DB_ENGINE=postgres
# DB_NAME=ladyrose
# DB_USER=postgres
# DB_PASSWORD=su_clave
# DB_HOST=localhost
# DB_PORT=5432

# Datos de Ladyrose (número con indicativo 57, sin + ni espacios)
LADYROSE_WHATSAPP=573000000000
LADYROSE_INSTAGRAM=https://www.instagram.com/
LADYROSE_FACEBOOK=https://www.facebook.com/
LADYROSE_TIKTOK=https://www.tiktok.com/
LADYROSE_TIEMPO_RESPUESTA=24 horas hábiles
LADYROSE_CORREO=hola@ladyrose.co
LADYROSE_DATOS_TRANSFERENCIA=Nequi 300 000 0000 a nombre de Ladyrose

# Correos (HU 10 y HU 26). Si no se ponen, los correos salen en la terminal.
# Ejemplo con Gmail (hay que crear una "contraseña de aplicación" en la cuenta de Google):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=ladyrose@gmail.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Ladyrose <ladyrose@gmail.com>

# Fotos en la nube (solo producción). Si no se pone, se guardan en la carpeta media/
# MEDIA_STORAGE=s3
# S3_BUCKET=ladyrose-fotos
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT_URL=      # solo si no es Amazon (ej. Cloudflare R2)
# S3_REGION=us-east-1
